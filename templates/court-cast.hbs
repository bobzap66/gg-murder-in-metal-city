<section class="gg-mimc-director gg-mimc-cast">
  <header class="gg-mimc-director-head"><div class="gg-mimc-eyebrow">MACHINE COURT · CAST &amp; WITNESSES</div><h2>{{sceneName}}</h2><p>Stage counsel and witnesses using your own character artwork.</p></header>
  <div class="gg-mimc-cast-stations">
    {{#each stations}}<article class="gg-mimc-record {{#if selected}}is-selected{{/if}}">
      <h3>{{label}}</h3><strong>{{occupant}}</strong>{{#if duplicates}}<small>Multiple managed tiles; placement repairs duplicates.</small>{{/if}}
      <div class="gg-mimc-actions"><button type="button" data-action="selectStation" data-station="{{id}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}">Edit</button>{{#if occupied}}<button type="button" data-action="focus" data-station="{{id}}">Spotlight</button><button type="button" data-action="dismiss" data-station="{{id}}">Dismiss</button>{{/if}}</div>
    </article>{{/each}}
  </div>
  <section class="gg-mimc-cue-group gg-mimc-evidence-fields">
    <h3>{{selected.label}} — placement</h3>
    <label>Display name<input name="name" maxlength="100" value="{{form.name}}" placeholder="Character name"></label>
    <label>Artwork path<file-picker name="image" type="image" value="{{form.image}}"></file-picker></label>
    <label>Or choose an existing world actor<select name="actorId"><option value="">Select actor</option>{{#each actors}}<option value="{{id}}">{{name}}</option>{{/each}}</select></label>
    <div class="gg-mimc-actions"><button type="button" data-action="actor" data-art="token">Use token artwork</button><button type="button" data-action="actor" data-art="portrait">Use portrait</button></div>
    <div class="gg-mimc-cast-geometry">
      <label>Horizontal center (%)<input type="number" name="center" min="0" max="100" step="0.1" value="{{form.center}}"></label>
      <label>Bottom baseline (%)<input type="number" name="baseline" min="0" max="100" step="0.1" value="{{form.baseline}}"></label>
      <label>Height (% of scene)<input type="number" name="height" min="5" max="85" step="0.1" value="{{form.height}}"></label>
    </div>
    {{#if placed}}
    <div class="gg-mimc-cast-adjust">
      <div class="gg-mimc-nudge"><h3>Move character</h3><div class="gg-mimc-dpad">
        <button type="button" class="up" data-action="nudge" data-axis="baseline" data-sign="-1" title="Move up" aria-label="Move up"><i class="fa-solid fa-arrow-up"></i></button>
        <button type="button" class="left" data-action="nudge" data-axis="center" data-sign="-1" title="Move left" aria-label="Move left"><i class="fa-solid fa-arrow-left"></i></button>
        <button type="button" class="down" data-action="nudge" data-axis="baseline" data-sign="1" title="Move down" aria-label="Move down"><i class="fa-solid fa-arrow-down"></i></button>
        <button type="button" class="right" data-action="nudge" data-axis="center" data-sign="1" title="Move right" aria-label="Move right"><i class="fa-solid fa-arrow-right"></i></button>
      </div></div>
      <div><label>Step size<select name="step"><option value="0.5" {{#if fine}}selected{{/if}}>Fine (0.5%)</option><option value="1" {{#unless fine}}{{#unless coarse}}selected{{/unless}}{{/unless}}>Normal (1%)</option><option value="2" {{#if coarse}}selected{{/if}}>Coarse (2%)</option></select></label>
      <div class="gg-mimc-actions"><button type="button" data-action="nudge" data-axis="height" data-sign="-1"><i class="fa-solid fa-minus"></i> Smaller</button><button type="button" data-action="nudge" data-axis="height" data-sign="1"><i class="fa-solid fa-plus"></i> Larger</button></div></div>
    </div>
    <div class="gg-mimc-actions"><button type="button" data-action="drag"><i class="fa-solid fa-arrows-up-down-left-right"></i> Unlock &amp; drag</button><button type="button" data-action="lock"><i class="fa-solid fa-lock"></i> Lock position</button><small data-drag-status>{{#if unlocked}}Unlocked — drag on Tiles layer{{else}}Locked{{/if}}</small></div>
    <small>Movement, size and mirror save immediately. Drag with Foundry's Tiles layer, then lock position. Name and artwork still require Place / update.</small>
    {{/if}}
    <label class="gg-mimc-inline-check"><input type="checkbox" name="mirror" {{#if form.mirror}}checked{{/if}}> Mirror horizontally</label>
    <label class="gg-mimc-inline-check"><input type="checkbox" name="lighting" {{#if lighting}}checked{{/if}}> Spotlight after placement</label>
    <div class="gg-mimc-actions"><button type="button" data-action="place"><i class="fa-solid fa-user-plus"></i> Place / update character</button><button type="button" data-action="defaults">Default position</button><button type="button" data-action="refresh">Refresh</button></div>
  </section>
  <p class="gg-mimc-legal">Characters are visible image tiles, not linked actors. Transparent full-body artwork works best. Placement or dismissal affects all viewers. Save before switching stations. No hidden witness queue is stored on the scene; select the next witness when ready.</p>
</section>
