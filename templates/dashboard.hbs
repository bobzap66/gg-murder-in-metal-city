<section class="gg-mimc-manager">
  <header class="gg-mimc-hero">
    <div><div class="gg-mimc-eyebrow">GREENE GAMING · ADVENTURE MANAGER</div>
    <h1>Murder in Metal City Add-Ons</h1>
    <p>Independent scene imports and tools for the GM.</p></div>
    <span class="gg-mimc-version">v{{version}} · Development</span>
  </header>
  <aside class="gg-mimc-notice"><i class="fa-solid fa-circle-info"></i> Base scene imports are available. The Machine Court Director, shared evidence library and Chase Director are available. Importing does not activate a scene or alter an existing one.</aside>
  <div class="gg-mimc-features">
  {{#each features}}
    <article class="gg-mimc-feature">
      <img class="gg-mimc-feature-art" src="{{image}}" alt="">
      <div class="gg-mimc-feature-body">
        <div class="gg-mimc-feature-heading"><h2><i class="{{icon}}"></i> {{title}}</h2>
        {{#if installed}}<span class="gg-mimc-state installed">Imported</span>{{else}}<span class="gg-mimc-state">Ready to import</span>{{/if}}</div>
        <p>{{description}}</p>
        <p class="gg-mimc-available"><strong>Available:</strong> {{available}}</p>
        <p class="gg-mimc-pending"><strong>Planned:</strong> {{pending}}</p>
        <div class="gg-mimc-actions">
        {{#if installed}}
          {{#each scenes}}<button type="button" data-action="openScene" data-scene="{{id}}"><i class="fa-solid fa-eye"></i> View {{name}}</button>{{#if ../courtroom}}<button type="button" data-action="courtDirector" data-scene="{{id}}"><i class="fa-solid fa-lightbulb"></i> Open Director</button>{{/if}}{{#if ../investigation}}<button type="button" data-action="evidenceManager" data-scene="{{id}}"><i class="fa-solid fa-fingerprint"></i> Manage evidence board</button>{{/if}}{{#if ../chase}}<button type="button" data-action="chaseDirector" data-scene="{{id}}"><i class="fa-solid fa-person-running"></i> Open Chase Director</button>{{/if}}{{/each}}
        {{else}}
          <button type="button" data-action="importScene" data-feature="{{id}}" {{#if ../busy}}disabled{{/if}}><i class="fa-solid fa-download"></i> Import base scene</button>
        {{/if}}
          {{#if investigation}}<button type="button" data-action="evidenceManager"><i class="fa-solid fa-folder-open"></i> Shared evidence library</button>{{/if}}
          {{#if courtroom}}<button type="button" data-action="courtRoster"><i class="fa-solid fa-book-open"></i> Court officials</button>{{/if}}
        </div>
        {{#if multiple}}<small>Multiple imported scenes found. None will be replaced.</small>{{/if}}
      </div>
    </article>
  {{/each}}
  </div>
  <section class="gg-mimc-cue-group"><h3>GM hotbar shortcuts</h3><p>Install reusable GM macros in the Macro Directory. Existing shortcuts are preserved; no hotbar slots are changed.</p><div class="gg-mimc-actions">{{#if missingMacros}}<button type="button" data-action="installMacros"><i class="fa-solid fa-bolt"></i> Install GM Macros ({{missingMacros}} missing)</button>{{else}}<span class="gg-mimc-state installed">All {{totalMacros}} shortcuts available</span>{{/if}}</div></section>
  <footer class="gg-mimc-actions gg-mimc-footer">
    <button type="button" data-action="configuration"><i class="fa-solid fa-file-export"></i> Configuration Import / Export</button>
    <button type="button" data-action="evidenceLibrary"><i class="fa-solid fa-folder-open"></i> Evidence template library</button>
    <button type="button" data-action="refresh"><i class="fa-solid fa-rotate"></i> Refresh</button>
  </footer>
  <p class="gg-mimc-legal">Unofficial supplement · AI-generated artwork · No adventure handouts included · Foundry v14 development build</p>
</section>
