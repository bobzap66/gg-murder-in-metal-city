<section class="gg-mimc-manager gg-mimc-evidence-manager">
  <header class="gg-mimc-hero"><div><div class="gg-mimc-eyebrow">SHARED EVIDENCE LIBRARY</div><h1>Investigation dossier</h1><p>Prepare privately, publish deliberately, and place discovered evidence.</p></div></header>
  <aside class="gg-mimc-notice">Only published snapshots are player-readable. Draft edits stay private. Save before switching records or boards. Withdrawing removes managed board placements, but cannot erase information already seen.</aside>
  <div class="gg-mimc-actions"><button type="button" data-action="newDraft">New evidence draft</button><button type="button" data-action="refresh">Refresh</button></div>
  <div class="gg-mimc-evidence-layout">
    <section class="gg-mimc-cue-group"><h3>Evidence records</h3>
      {{#each drafts}}<article class="gg-mimc-record {{#if selected}}is-selected{{/if}}">
        <strong>{{title}}</strong><small>{{#if published}}{{#if visible}}Published{{else}}Publication incomplete / restricted{{/if}}{{else}}Private draft{{/if}}</small>
        <div class="gg-mimc-actions"><button type="button" data-action="editDraft" data-id="{{id}}">Edit</button>{{#if published}}{{#if visible}}<button type="button" data-action="openJournal" data-id="{{publicId}}">View</button>{{/if}}<button type="button" data-action="withdraw" data-id="{{id}}">Withdraw</button>{{else}}<button type="button" data-action="publish" data-id="{{id}}">Publish saved draft</button>{{/if}}</div>
      </article>{{else}}<p>No evidence yet. Create a draft to get started.</p>{{/each}}
    </section>
    <section class="gg-mimc-cue-group gg-mimc-evidence-fields"><h3>{{#if editing}}Edit private draft{{else}}New private draft{{/if}}</h3>
      <label>Title<input name="title" maxlength="100" value="{{current.title}}"></label>
      <label>Template<select name="templateId">{{#each templates}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{title}}</option>{{/each}}</select></label>
      <label>Custom artwork path (optional)<file-picker type="image" name="image" value="{{current.image}}"></file-picker></label>
      {{#each fields}}<label><span data-label="{{id}}">{{label}}</span><textarea name="{{id}}" rows="3">{{value}}</textarea></label>{{/each}}
      <label>GM notes — never published<textarea name="gmNotes" rows="4">{{current.gmNotes}}</textarea></label>
      <div class="gg-mimc-actions"><button type="button" data-action="saveDraft"><i class="fa-solid fa-floppy-disk"></i> Save private draft</button></div>
    </section>
  </div>
  <section class="gg-mimc-cue-group gg-mimc-evidence-fields"><h3>Investigation board</h3>
  {{#if hasBoard}}
    <label>Board<select name="boardId">{{#each boards}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
    <label>Evidence position<select name="slotId">{{#each slots}}<option value="{{id}}">{{label}}</option>{{/each}}</select></label>
    <label>Discovered evidence<select name="journalId"><option value="">Select published evidence</option>{{#each evidence}}<option value="{{id}}">{{title}}</option>{{/each}}</select></label>
    <div class="gg-mimc-actions"><button type="button" data-action="place">Place / replace selected slot</button><button type="button" data-action="remove">Clear selected slot</button></div>
    <div class="gg-mimc-actions"><button type="button" data-action="repairBoard"><i class="fa-solid fa-wrench"></i> Repair board alignment</button></div>
    <p>Artwork is fitted inside the frame with a small journal shortcut in the lower-right corner. Players can also open discovered evidence through the Journal sidebar.</p>
    <h3>Case subject (visible to all board viewers)</h3>
    <label>Subject name<input name="subjectName" maxlength="80" placeholder="Name shown on board"></label>
    <label>Portrait path<file-picker type="image" name="subjectImage"></file-picker></label>
    <div class="gg-mimc-actions"><button type="button" data-action="subject">Set / clear subject (blank clears)</button></div>
  {{else}}<p>Import the investigation base scene in Adventure Manager to place evidence.</p>{{/if}}
  </section>
  <p class="gg-mimc-legal">No adventure clues are bundled. Only publish information you intend all players to read.</p>
</section>
